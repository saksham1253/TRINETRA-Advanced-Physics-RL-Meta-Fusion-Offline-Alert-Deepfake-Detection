{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "test": "vitest run",
    "golden": "python3 tools/export_golden.py && vitest run src/console/engine",
    "build:data": "python3 tools/build_geo_pack.py && python3 tools/cache_terrain.py && python3 tools/extract_params.py && python3 tools/export_evidence_bank.py",
    "demo:offline": "python3 tools/stamp_build.py && vite build && vite preview --host 0.0.0.0 --port 4173",
    "gateway": "python3 tools/mock_gateway.py --port 8765"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
