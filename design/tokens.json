{
  "$description": "TRINETRA Command Console design tokens (dark default, light for projectors and print). Severity colours are reserved for severity only (section 2B).",
  "color": {
    "dark": {
      "bg": "#0D0A09", "surface": "#17110F", "raised": "#211916", "hairline": "#3A2C26", "scrim": "rgba(13,10,9,0.82)",
      "text": "#F7EFE8", "text2": "#BFAFA3", "text3": "#8A7A6F",
      "brand": "#FF6A1A", "brandBright": "#FF8A3D", "brandDeep": "#D9480F", "gold": "#FFC145",
      "classA": "#5B8DEF", "classB": "#3DDC97", "classC": "#A78BFA"
    },
    "light": {
      "bg": "#F4EFE9", "surface": "#FFFFFF", "raised": "#FBF7F3", "hairline": "#D9CEC4", "scrim": "rgba(244,239,233,0.9)",
      "text": "#1E1612", "text2": "#54463D", "text3": "#7A6B60",
      "brand": "#C2410C", "brandBright": "#D9480F", "brandDeep": "#9A3412", "gold": "#A16207",
      "classA": "#2F5FC4", "classB": "#1F8A5B", "classC": "#6D4FC8"
    },
    "severity": {
      "advisory": { "dark": "#2EC4B6", "light": "#0F766E", "shape": "circle", "label": "Advisory" },
      "watch": { "dark": "#FFC145", "light": "#A16207", "shape": "circle", "label": "Watch" },
      "warning": { "dark": "#FF7A1A", "light": "#C2410C", "shape": "diamond", "label": "Warning" },
      "emergency": { "dark": "#FF3B30", "light": "#B91C1C", "shape": "octagon", "label": "Emergency" }
    }
  },
  "font": { "display": "Space Grotesk Variable", "ui": "Inter Variable", "mono": "JetBrains Mono Variable", "devanagari": "Noto Sans Devanagari" },
  "type": { "display": "28/34 600", "title": "18/24 600", "section": "13/18 600", "body": "14/20 400", "caption": "12/16 500", "mono": "13/18 500" },
  "space": [0, 4, 8, 12, 16, 24, 32, 48], "radius": { "sm": 4, "md": 8 },
  "motion": { "fast": "150ms", "base": "200ms", "slow": "250ms", "camera": "1500-3000ms ease-in-out", "maxFlashHz": 3 },
  "elevation": { "panel": "0 1px 0 rgba(0,0,0,.4)", "overlay": "0 8px 24px rgba(0,0,0,.45)" }
}
